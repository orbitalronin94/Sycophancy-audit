# Sycophancy Audit — configuración de ejemplo

# Servidor
AUDIT_HOST=127.0.0.1
AUDIT_PORT=8000

# Seguridad: cambia este valor por un token largo y aleatorio
AUDIT_TOKEN=change-this-to-a-long-random-secret

# Base de datos
AUDIT_DB=./audit.db

# CORS: especifica los orígenes autorizados, separados por comas
AUDIT_CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Ejecución
AUDIT_MAX_PARALLEL=4
AUDIT_TIMEOUT=60
AUDIT_MAX_RETRIES=3
